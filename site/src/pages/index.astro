---
import Base from '../layouts/Base.astro';
import { computeStats } from '../lib/stats';
import { loadQuestions } from '../lib/questions';

const questions = loadQuestions().sort((a, b) => a.id.localeCompare(b.id));

const allTags = [...new Set(questions.flatMap((q) => q.tags))].sort();
---

<Base title="AI Alignment Report">
  <p class="text-gray-600 mb-6 max-w-2xl">Looking for bias in various AI models by asking advice questions.</p>

  <div class="flex flex-wrap gap-2 mb-8" id="filter-bar">
    <button
      class="filter-btn px-3 py-1 rounded-full text-sm font-medium bg-indigo-600 text-white"
      data-tag="all"
    >All</button>
    {allTags.map((tag) => (
      <button
        class="filter-btn px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200"
        data-tag={tag}
      >{tag}</button>
    ))}
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="question-grid">
    {questions.map((q) => {
      const visibleResults = q.results;
      const stats = computeStats(visibleResults);
      const MUTED = ['hedge', 'refusal', 'other'];
      const realAnswers = stats?.macroAnswers.filter((a) => !MUTED.includes(a.value)) ?? [];
      const top = realAnswers[0];
      const pct = top?.percent ?? 0;
      const colors = pct >= 70
        ? { badge: 'bg-green-100 text-green-800', bar: '#86efac', border: 'border-green-400' }
        : pct >= 50
        ? { badge: 'bg-indigo-100 text-indigo-800', bar: '#a5b4fc', border: 'border-indigo-400' }
        : { badge: 'bg-amber-100 text-amber-800', bar: '#fcd34d', border: 'border-amber-400' };
      const runnerUpColor = '#c4b5fd';
      const cycleColors = ['#a78bfa', '#bfdbfe', '#fbcfe8'];
      const mutedColor = '#e5e7eb';
      return (
        <a
          href={`/${q.id}`}
          class={`block bg-white border border-gray-200 border-l-4 ${colors.border} rounded-lg p-5 hover:shadow-sm transition`}
          data-tags={JSON.stringify(q.tags)}
        >
          <p class="font-medium text-gray-900 mb-3">{q.displayQuestion ?? q.prompts[0]}</p>
          {stats && top ? (
            <div class="bg-gray-50 border border-gray-100 rounded-md p-3">
              <div class="flex items-center gap-2 mb-2 flex-wrap">
                <span class={`${colors.badge} text-xs font-semibold px-2 py-0.5 rounded-full`}>
                  {top.value}
                </span>
                <span class="text-sm text-gray-600">{top.percent}%</span>
                {realAnswers[1] && (
                  <>
                    <span class="text-xs text-gray-400">vs</span>
                    <span class="bg-violet-100 text-violet-700 text-xs font-semibold px-2 py-0.5 rounded-full">
                      {realAnswers[1].value}
                    </span>
                    <span class="text-sm text-gray-500">{realAnswers[1].percent}%</span>
                  </>
                )}
              </div>
              <div class="flex h-2 rounded-full overflow-hidden gap-px mb-2">
                {stats.macroAnswers
                  .filter((a) => a.percent >= 5)
                  .map((a) => {
                    const realIdx = realAnswers.findIndex((r) => r.value === a.value);
                    const bg = MUTED.includes(a.value)
                      ? mutedColor
                      : realIdx === 0
                      ? colors.bar
                      : realIdx === 1
                      ? runnerUpColor
                      : cycleColors[(realIdx - 2) % cycleColors.length];
                    return <div style={`width:${a.percent}%;background:${bg}`} />;
                  })}
              </div>
              <p class="text-xs text-gray-500">{stats.agreeing} of {stats.total} model{stats.total !== 1 ? 's' : ''} agree</p>
            </div>
          ) : (
            <p class="text-sm text-gray-500">{visibleResults.length} model{visibleResults.length !== 1 ? 's' : ''}</p>
          )}
        </a>
      );
    })}
  </div>

  <p id="no-results" class="hidden text-gray-500 mt-8">No questions match this filter.</p>

  {questions.length === 0 && (
    <p class="text-gray-500">No results yet. Run <code class="bg-gray-100 px-1 rounded">npm run cli run</code> to generate results.</p>
  )}
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('#question-grid a');
  const noResults = document.getElementById('no-results')!;

  function setActive(tag: string) {
    buttons.forEach((btn) => {
      const isActive = btn.dataset.tag === tag;
      btn.classList.toggle('bg-indigo-600', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('bg-gray-100', !isActive);
      btn.classList.toggle('text-gray-700', !isActive);
    });

    let visible = 0;
    cards.forEach((card) => {
      const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
      const show = tag === 'all' || tags.includes(tag);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    noResults.classList.toggle('hidden', visible > 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => setActive(btn.dataset.tag ?? 'all'));
  });
</script>
