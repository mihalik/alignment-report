---
import Base from '../../layouts/Base.astro';
import { listModels } from '../../../../src/models.js';
import { loadQuestions, type ModelResult } from '../../lib/questions';

interface ModelQuestion {
  id: string;
  displayQuestion?: string;
  prompts: string[];
  result: ModelResult;
}

export async function getStaticPaths() {
  const questions = loadQuestions();
  const models = listModels().filter((m) => !m.hidden);

  return models.map((model) => {
    const modelQuestions: ModelQuestion[] = questions
      .map((data) => {
        const entry = data.results.find((r) => r.model === model.name);
        if (!entry) return null;
        return {
          id: data.id,
          displayQuestion: data.displayQuestion,
          prompts: data.prompts,
          result: entry,
        };
      })
      .filter(Boolean) as ModelQuestion[];

    const siblings = models.filter((m) => m.company === model.company && m.name !== model.name);

    return {
      params: { id: model.name },
      props: { modelName: model.name, company: model.company, modelQuestions, siblings },
    };
  });
}

const { modelName, company, modelQuestions, siblings } = Astro.props as {
  modelName: string;
  company: string;
  modelQuestions: ModelQuestion[];
  siblings: Array<{ name: string; company: string }>;
};

const reserved: Record<string, string> = {
  refusal: '#ef4444',
  hedge:   '#9ca3af',
  other:   '#f59e0b',
};

const palette = [
  '#6366f1', '#10b981', '#8b5cf6',
  '#06b6d4', '#f97316', '#ec4899', '#84cc16', '#14b8a6',
  '#f43f5e', '#a855f7', '#0ea5e9', '#d97706', '#22c55e',
  '#e879f9', '#64748b', '#dc2626',
];

// Build a global color map across all answer values this model produced
const allValues = new Set<string>();
for (const q of modelQuestions) {
  for (const { value } of q.result.answers) {
    allValues.add(value);
  }
}

const colorMap = new Map<string, string>();
let ci = 0;
for (const value of allValues) {
  if (reserved[value]) {
    colorMap.set(value, reserved[value]);
  } else {
    colorMap.set(value, palette[ci++ % palette.length]);
  }
}
---

<Base title={modelName}>
  <div class="mb-6">
    <a href="/models" class="text-sm text-indigo-600 hover:underline">← All models</a>
  </div>

  <h1 class="text-2xl font-bold mb-1">{modelName}</h1>
  <p class="text-sm text-gray-500 mb-8">{company}</p>

  {siblings.length > 0 && (
    <div class="bg-white border border-gray-200 rounded-xl p-5 mb-10">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">
        Other {company} models
      </p>
      <div class="flex flex-wrap gap-2">
        {siblings.map((s) => (
          <a
            href={`/models/${s.name}`}
            class="text-sm text-indigo-600 hover:underline bg-indigo-50 px-3 py-1 rounded-full"
          >
            {s.name}
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="space-y-8">
    {modelQuestions.map((q) => (
      <div class="bg-white border border-gray-200 rounded-xl p-5">
        <a href={`/${q.id}`} class="text-sm font-semibold text-gray-800 hover:text-indigo-600 hover:underline mb-3 block">
          {q.displayQuestion ?? q.prompts[0]} →
        </a>
        <div class="flex h-7 rounded overflow-hidden w-full">
          {q.result.answers
            .filter(({ percent }) => percent > 0)
            .map(({ value, percent }) => (
              <div
                class="flex items-center justify-center overflow-hidden"
                style={`width:${percent}%;background-color:${colorMap.get(value)}`}
              >
                {percent >= 10 && (
                  <span class="text-xs text-white font-medium truncate px-1 select-none">
                    {value} {percent}%
                  </span>
                )}
              </div>
            ))
          }
        </div>
        <p class="text-xs text-gray-400 mt-2">{q.result.runs} runs</p>
      </div>
    ))}
  </div>
</Base>
