---
import Base from '../../layouts/Base.astro';
import { listModels } from '../../../../src/models.js';

const models = listModels().filter((m) => !m.hidden);

// Group by company, preserving registry order within each group
const groupMap = new Map<string, typeof models>();
for (const model of models) {
  if (!groupMap.has(model.company)) groupMap.set(model.company, []);
  groupMap.get(model.company)!.push(model);
}
const groups = Array.from(groupMap.entries()).sort(([a], [b]) => a.localeCompare(b));
---

<Base title="Models">
  <h1 class="text-2xl font-bold mb-8">Models</h1>

  <div class="space-y-10">
    {groups.map(([company, companyModels]) => (
      <div>
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4 border-b border-gray-100 pb-2">
          {company}
        </h2>
        <div class="grid gap-2">
          {companyModels.map((model) => (
            <a
              href={`/models/${model.name}`}
              class="flex items-center justify-between bg-white border border-gray-200 rounded-lg px-4 py-3 hover:border-indigo-300 hover:shadow-sm transition-all"
            >
              <span class="text-sm font-medium text-gray-800">{model.name}</span>
              <span class="text-xs text-indigo-600">View results →</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</Base>
