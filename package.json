{
  "name": "ai-alignment-report",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "site"
  ],
  "scripts": {
    "cli": "node --env-file=.env --import tsx/esm src/cli.ts",
    "outliers": "node --import tsx/esm src/outliers-cli.ts",
    "test": "vitest run",
    "site:dev": "npm run dev --workspace=site",
    "site:build": "npm run build --workspace=site",
    "site:preview": "npm run preview --workspace=site",
    "deploy": "npm run site:build && wrangler pages deploy"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/react": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.69.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^7.0.15",
    "ink": "^7.1.0",
    "p-limit": "^7.3.0",
    "react": "^19.2.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@openrouter/ai-sdk-provider": {
      "ai": "$ai"
    }
  }
}
