# Add API keys for LLM providers as needed
OPENROUTER_API_KEY=your-key-here
META_API_KEY=your-key-here

# All of these can also be set as CLI flags (flag wins over env)
# MAX_RUNS=40               # --max-runs: runs per pair (default 10)
# CONSENSUS_THRESHOLD=10    # --threshold: early-stop once one answer reaches this count
#                           # (unset = every pair runs the full MAX_RUNS)
# BATCH_SIZE=5              # --batch-size (default = threshold if set, else 5)
# LLM_CONCURRENCY=10        # --concurrency (global in-flight LLM request limit)
# BENCH_PAIRS=4             # --pairs (model×question pairs run concurrently)

# Env only
# LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=3
# LLM_MAX_OUTPUT_TOKENS=    # unset = provider default
# LOG_REASONING=true        # print reasoning text (plain --no-ui output only)
